bool test4 = (5 != 6);
bool test5 = (4 < 5);
bool test6 = (6 > 5);

// ==================== LOGICAL OPERATOR COMBINATIONS ====================
bool l1 = true && true;
bool l2 = true && false;
bool l3 = false || true;
bool l4 = false || false;
bool l5 = !true;
bool l6 = !false;
bool l7 = true and true;
bool l8 = true or false;
bool l9 = not false;

