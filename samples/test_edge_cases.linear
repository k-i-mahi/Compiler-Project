// ==================== CONSECUTIVE OPERATORS ====================
int a = 5;
a++;
a--;
int b = a + + 3;
int c = a - - 3;
int d = a * - 3;

// ==================== OPERATOR PRECEDENCE TESTS ====================
int expr1 = 5 + 3 * 2;
int expr2 = (5 + 3) * 2;
int expr3 = 10 / 2 + 3;
int expr4 = 10 % 3 + 2;

// ==================== CHAINED ASSIGNMENTS ====================
int x = 10;
x += 5;
x -= 2;
x *= 3;
x /= 2;
x %= 7;

// ==================== RELATIONAL OPERATOR COMBINATIONS ====================
