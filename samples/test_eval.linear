START main {
    // Basic types
    int i = 5;
    float f = 2.5;
    string s = "Linear Evaluator works!";
    bool b = true;

    MAHI_write(s);
    MAHI_write("Initial i = ");
    MAHI_write(i);

    // Loops and Control flow
    int sum = 0;
    for (int j = 1; j <= i; j = j + 1) {
        if (j % 2 == 0) {
            sum = sum + j;
        }
    }
    MAHI_write("Sum of evens up to 5 is:");
    MAHI_write(sum);

    // Test Data Structures System
    MAHI_write("--- Testing DSU ---");
    DSU mydsu = dsu_new(10);
    dsu_union(mydsu, 1, 2);
    dsu_union(mydsu, 2, 3);
    MAHI_write("Are 1 and 3 in same set? ");
    MAHI_write(dsu_same(mydsu, 1, 3)); // should be 1 (true)
    MAHI_write("Are 1 and 4 in same set? ");
    MAHI_write(dsu_same(mydsu, 1, 4)); // should be 0 (false)

    MAHI_write("--- Testing Graph ---");
    Graph mygraph = graph_new(5);
    graph_add_edge(mygraph, 0, 1);
    graph_add_edge(mygraph, 1, 2);
    MAHI_write("BFS shortest path 0 to 2:");
    MAHI_write(graph_shortest_path(mygraph, 0, 2)); // should be 2
    
    MAHI_write("--- Testing Ordered Set ---");
    OrderedSet myset = oset_new();
    oset_insert(myset, 10);
    oset_insert(myset, 5);
    oset_insert(myset, 20);
    MAHI_write("Size of oset:");
    MAHI_write(oset_size(myset)); // 3
    MAHI_write("0-th smallest (should be 5):");
    MAHI_write(oset_nth(myset, 0)); // 5
    MAHI_write("1-st smallest (should be 10):");
    MAHI_write(oset_nth(myset, 1)); // 10

    MAHI_write("--- Testing Tree ---");
    Tree mytree = tree_new(5);
    tree_set_parent(mytree, 1, 0);
    tree_set_parent(mytree, 2, 0);
    tree_set_parent(mytree, 3, 1);
    tree_set_parent(mytree, 4, 1);
    MAHI_write("Tree LCA of 3 and 4 (should be 1):");
    MAHI_write(tree_lca(mytree, 3, 4));
    MAHI_write("Tree Depth of 4 (should be 2):");
    MAHI_write(tree_depth(mytree, 4));

    MAHI_write("--- Testing RangeTree (Segment Tree) ---");
    RangeTree st = segtree_new(10);
    segtree_set(st, 0, 5);
    segtree_set(st, 1, 10);
    segtree_set(st, 2, 15);
    MAHI_write("Range sum [0, 2] (should be 30):");
    MAHI_write(segtree_sum(st, 0, 2));
    MAHI_write("Range min [0, 2] (should be 5):");
    MAHI_write(segtree_min(st, 0, 2));

    MAHI_write("--- Testing Matrix ---");
    Matrix matA = matrix_new(2, 2);
    matrix_set(matA, 0, 0, 1.0);
    matrix_set(matA, 0, 1, 2.0);
    matrix_set(matA, 1, 0, 3.0);
    matrix_set(matA, 1, 1, 4.0);
    MAHI_write("Matrix A[1][0] (should be 3):");
    MAHI_write(matrix_get(matA, 1, 0));

    Matrix matI = matrix_identity(2);
    Matrix matR = matrix_mul(matA, matI);
    MAHI_write("Matrix R[0][1] after identity mul (should be 2):");
    MAHI_write(matrix_get(matR, 0, 1));

    MAHI_write("--- Testing Stack ---");
    Stack stck = stack_new();
    stack_push(stck, 100);
    stack_push(stck, 200);
    MAHI_write("Stack Top (should be 200):");
    MAHI_write(stack_top(stck));
    stack_pop(stck);
    MAHI_write("Stack Size (should be 1):");
    MAHI_write(stack_size(stck));

    MAHI_write("--- Testing Queue ---");
    Queue q = queue_new();
    queue_push(q, 300);
    queue_push(q, 400);
    MAHI_write("Queue Front (should be 300):");
    MAHI_write(queue_front(q));
    queue_pop(q);
    MAHI_write("Queue Size (should be 1):");
    MAHI_write(queue_size(q));

} END
