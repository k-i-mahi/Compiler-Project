function int add(int a, int b) {
    return a + b;
}

function float multiply(float x, float y) {
    return x * y;
}

function void greet(string name) {
    MAHI_write("Hello");
    MAHI_write(name);
    return 0;
}

START main {
    int sum = add(5, 10);
    MAHI_write("sum:");
    MAHI_write(sum);

    float product = multiply(3.5, 2.0);
    MAHI_write("product:");
    MAHI_write(product);

    greet("Mahi");
} END
