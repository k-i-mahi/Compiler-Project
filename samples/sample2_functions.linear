// Description: Functions and advanced data structures

// Function definition
func int add(int a, int b)
begin
    return a + b;
end

func float multiply(float x, float y)
begin
    return x * y;
end

func void greet(string name)
begin
    print("Hello, ");
    print(name);
end

// Main program
int main()
begin
    // Using functions
    int sum = add(5, 10);
    print(sum);
    
    float product = multiply(3.5, 2.0);
    print(product);
    
    greet("Mahi");
    
    // Graph declaration
    graph g;
    
    // Tree declaration
    tree t;
    
    // DSU for union-find
    dsu uf;
    
    // Matrix operations
    matrix m;
    
    // Ordered set
    ordered_set os;
    
    // Range tree for queries
    range_tree rt;
    
    // Using custom Mahi functions
    string text = "Linear";
    string reversed = mahi_reverse(text);
    print("Reversed: ");
    print(reversed);
    
    return 0;
end
