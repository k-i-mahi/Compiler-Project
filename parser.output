Grammar

    0 $accept: program $end

    1 $@1: /* empty */

    2 program: T_START T_MAIN $@1 block_statement T_END

    3 statements: /* empty */
    4           | statement statements

    5 statement: declaration_statement
    6          | assignment_statement
    7          | expression_statement
    8          | if_statement
    9          | while_statement
   10          | for_statement
   11          | block_statement
   12          | T_BREAK T_SEMICOLON
   13          | T_CONTINUE T_SEMICOLON
   14          | T_RETURN expression T_SEMICOLON
   15          | T_SEMICOLON

   16 argument_list: expression
   17              | argument_list T_COMMA expression

   18 opt_argument_list: /* empty */
   19                  | argument_list

   20 $@2: /* empty */

   21 block_statement: T_LBRACE $@2 statements T_RBRACE

   22 declaration_statement: type_specifier T_IDENTIFIER T_SEMICOLON
   23                      | type_specifier T_IDENTIFIER T_ASSIGN expression T_SEMICOLON

